# ═══════════════════════════════════════════════════════════════════
# QgisRemoteMCP — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values for your deployment.

# ── MCP Server ────────────────────────────────────────────────────
MCP_PORT=8100

# ── QGIS Display ─────────────────────────────────────────────────
QGIS_RESOLUTION=1920x1080x24

# ── Ports (host-side) ────────────────────────────────────────────
QGIS_VNC_PORT=6080
API_PORT=8081
STREAM_PORT=8082

# ── External vision services (optional) ──────────────────────────
MOONDREAM_URL=http://host.docker.internal:8001
SAMGEO3_URL=http://host.docker.internal:8002
DEPTHPRO_URL=http://host.docker.internal:8003

# ── Multi-user mode (optional) ───────────────────────────────────
# Set to true to enable per-user isolated QGIS containers.
# Requires Docker socket mounted in docker-compose.yml.
MULTI_USER_MODE=false
JWT_SECRET=change-me-in-production
IDLE_TIMEOUT_MINUTES=30

# Docker image used for worker containers (multi-user mode)
# QGIS_IMAGE=qgisremotemcp:latest

# Port ranges for worker containers (each user takes 1 port per range)
# Ensure these ranges don't conflict with other services.
# BASE_API_PORT=14100
# BASE_STREAM_PORT=14200
# BASE_NOVNC_PORT=14300
# MAX_CONTAINERS=50
