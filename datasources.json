{
  "version": "1.0",
  "description": "Default data source catalog for BigQgisMCP. All IGN sources are free (no API key since July 2021).",
  "categories": ["basemap", "imagery", "topography", "administrative", "elevation", "environment", "api"],
  "sources": [
    {
      "id": "osm_xyz",
      "name": "OpenStreetMap",
      "category": "basemap",
      "type": "xyz",
      "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "params": {"zmin": "0", "zmax": "19"},
      "description": "OpenStreetMap standard tile layer"
    },
    {
      "id": "ign_planign",
      "name": "Plan IGN v2",
      "category": "basemap",
      "type": "wms",
      "url": "https://data.geopf.fr/wms-r",
      "params": {"layers": "GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2", "format": "image/png", "crs": "EPSG:3857"},
      "description": "Carte topographique IGN de la France"
    },
    {
      "id": "cartodb_positron",
      "name": "CartoDB Positron (Light)",
      "category": "basemap",
      "type": "xyz",
      "url": "https://cartodb-basemaps-a.global.ssl.fastly.net/light_all/{z}/{x}/{y}.png",
      "params": {"zmin": "0", "zmax": "19"},
      "description": "Fond de carte clair minimaliste"
    },
    {
      "id": "cartodb_dark",
      "name": "CartoDB Dark Matter",
      "category": "basemap",
      "type": "xyz",
      "url": "https://cartodb-basemaps-a.global.ssl.fastly.net/dark_all/{z}/{x}/{y}.png",
      "params": {"zmin": "0", "zmax": "19"},
      "description": "Fond de carte sombre"
    },
    {
      "id": "ign_ortho_wmts",
      "name": "Orthophotos IGN (WMTS)",
      "category": "imagery",
      "type": "wmts",
      "url": "https://data.geopf.fr/wmts",
      "params": {"layers": "ORTHOIMAGERY.ORTHOPHOTOS", "format": "image/jpeg", "tilematrixset": "PM", "crs": "EPSG:3857", "styles": "normal"},
      "description": "Photos aériennes haute résolution de la France (tuilées, rapide)"
    },
    {
      "id": "ign_ortho_wms",
      "name": "Orthophotos IGN (WMS)",
      "category": "imagery",
      "type": "wms",
      "url": "https://data.geopf.fr/wms-r",
      "params": {"layers": "ORTHOIMAGERY.ORTHOPHOTOS", "format": "image/jpeg", "crs": "EPSG:3857"},
      "description": "Photos aériennes IGN via WMS (plus lent, supporte GetFeatureInfo)"
    },
    {
      "id": "ign_ortho_irc",
      "name": "Orthophotos Infrarouge IGN",
      "category": "imagery",
      "type": "wms",
      "url": "https://data.geopf.fr/wms-r",
      "params": {"layers": "ORTHOIMAGERY.ORTHOPHOTOS.IRC", "format": "image/jpeg", "crs": "EPSG:3857"},
      "description": "Photos aériennes infrarouge (végétation, hydrologie)"
    },
    {
      "id": "ign_cadastre",
      "name": "Cadastre (Parcelles)",
